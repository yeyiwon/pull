# Server-only. Never prefix a secret with VITE_. Missing key or model means MOCK.
MORU_PROVIDER=MOCK
OPENAI_API_KEY=
# Planned development model; configuration only, not a runtime default.
MORU_OPENAI_MODEL=gpt-5.6-luna
# Optional, supported by the example Luna model. Unset for models without this control.
MORU_OPENAI_REASONING_EFFORT=none

# Public Supabase browser configuration. Never place service_role or secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
